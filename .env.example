# Local URL. Production uses the published Sites URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated administrator emails. Configure this as a secret in Sites.
ADMIN_EMAILS=

# Optional transactional email provider. Database persistence works without it.
RESEND_API_KEY=
EMAIL_FROM=contact@weareemedia.co.uk
EMAIL_REPLY_TO=contact@weareemedia.co.uk
BOOKING_NOTIFICATION_EMAIL=contact@weareemedia.co.uk

# Optional server-side defaults.
FEATURE_MEDIA_HUB_ENABLED=true
FEATURE_COMMUNITY_ENABLED=true
FEATURE_PAYMENTS_ENABLED=false

# Configure actual values only in the hosting secret manager.
ADMIN_LOGIN_CREDENTIAL=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Canonical HTTPS origin for recovery links (no user-supplied hosts).
ACCOUNT_RECOVERY_ORIGIN=
